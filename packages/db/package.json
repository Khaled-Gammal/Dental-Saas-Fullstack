{
  "name": "@dental/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node scripts/dbmate.mjs up",
    "rollback": "node scripts/dbmate.mjs rollback",
    "seed": "node scripts/run-sql.mjs seeds/dev_seed.sql",
    "reset": "node scripts/dbmate.mjs drop && node scripts/dbmate.mjs up && node scripts/run-sql.mjs seeds/dev_seed.sql",
    "types": "node scripts/codegen.mjs",
    "test": "node scripts/test-db.mjs",
    "seed:demo-billing": "node scripts/run-sql.mjs seeds/demo_billing.sql",
    "platform:admin": "node scripts/platform-admin.mjs"
  },
  "dependencies": {
    "kysely": "^0.28.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "dbmate": "^2.27.0",
    "dotenv": "^16.5.0",
    "kysely-codegen": "^0.18.5",
    "typescript": "^5.8.3"
  }
}
