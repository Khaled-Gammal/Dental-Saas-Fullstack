# Phase 1B: copy to docker/backup/backup.env (git-ignored). Read by the backup containers only; the app never sees it.
# docs/ops/backups.md explains each value.

# A role that can read every table (app_backup: BYPASSRLS + pg_read_all_data). In development the init script creates it
# on a new volume (docs/ops/backups.md has the command for an existing one). The password is passed to pg_dump through
# PGPASSWORD, never on its command line.
BACKUP_DATABASE_URL=postgres://app_backup:app_backup_dev@postgres:5432/dental

# Encrypts every backup (AES-256, at least 20 characters). Generate it with `openssl rand -hex 32`: letters and digits
# only, because Docker Compose expands "$" inside this file (a "$" would silently change the passphrase). Keep a copy
# OUTSIDE this server (a password manager): without it no backup can be restored, and with it and the bucket anyone can
# read every clinic's records. Changing it later is fine: old backups still need the old one.
BACKUP_PASSPHRASE=

# Where the backups go: s3://bucket/path on Cloudflare R2, AWS S3, Backblaze B2 or MinIO. A local path (/backups) is for
# trying it out only: a backup on the same server is lost with the server.
BACKUP_TARGET=/backups
# R2: https://<account id>.r2.cloudflarestorage.com ; AWS S3: leave empty
BACKUP_S3_ENDPOINT=
# an access key limited to this bucket (read, write, list, delete)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2: auto ; AWS: the bucket's region
AWS_DEFAULT_REGION=auto

# When (cron, in TZ) and how long to keep. The newest BACKUP_KEEP_MIN backups are never deleted.
BACKUP_CRON=15 2 * * *
TZ=Africa/Cairo
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7

# Dead man's switch: pinged on success (and /start, /fail), e.g. a healthchecks.io or Better Stack heartbeat URL that
# alerts you when no success arrives for ~25 hours. Empty = off.
BACKUP_HEALTHCHECK_URL=
# the same for the restore check
RESTORE_HEALTHCHECK_URL=
# the restore check fails when the newest backup is older than this
RESTORE_MAX_AGE_HOURS=36
