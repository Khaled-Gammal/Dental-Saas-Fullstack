{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "roots": ["<rootDir>", "<rootDir>/../src"],
  "testEnvironment": "node",
  "testRegex": "\\.(e2e-spec|spec)\\.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }] },
  "testTimeout": 20000
}
