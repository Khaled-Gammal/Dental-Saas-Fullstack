# Copy to .env (root) — every app reads this file.

NODE_ENV=development

# Database (docker compose maps Postgres to 5433)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/dental?sslmode=disable      # migrations + seeds only
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5433/dental                       # API (no RLS bypass)
DATABASE_WORKER_URL=postgres://app_worker:app_worker_dev@localhost:5433/dental             # worker jobs
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/dental_test?sslmode=disable
TEST_DATABASE_URL=postgres://app_user:app_user_dev@localhost:5433/dental_test

REDIS_URL=redis://localhost:6379

# Auth (dev values — generate long random secrets for production)
JWT_SECRET=dev-only-change-me-32-characters-minimum
BOOKING_CODE_SECRET=dev-only-booking-code-hmac-secret
DEV_LOGIN_ENABLED=true

# Domains. *.lvh.me always resolves to 127.0.0.1, so clinic subdomains work locally:
#   http://lvh.me:3000            landing page
#   http://clinic-a.lvh.me:3000   demo clinic A website
ROOT_DOMAIN=lvh.me
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:5173

# Mail (Mailpit catches everything locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# Object storage (MinIO console: http://localhost:9001  user minio / minio12345)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=dental-dev

# Dashboard (browser) — only VITE_* variables are exposed to the browser
VITE_API_URL=http://localhost:4000
