# Copy to .env (root) — every app reads this file.

NODE_ENV=development

# Database (docker compose maps Postgres to 5433)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/dental?sslmode=disable      # migrations + seeds only
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5433/dental                       # API (no RLS bypass)
DATABASE_WORKER_URL=postgres://app_worker:app_worker_dev@localhost:5433/dental             # worker jobs
DATABASE_PLATFORM_URL=postgres://app_platform:app_platform_dev@localhost:5433/dental       # platform admin panel only (same database as DATABASE_URL)
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/dental_test?sslmode=disable
TEST_DATABASE_URL=postgres://app_user:app_user_dev@localhost:5433/dental_test

REDIS_URL=redis://localhost:6379

# Auth (dev values — generate long random secrets for production)
JWT_SECRET=dev-only-change-me-32-characters-minimum
BOOKING_CODE_SECRET=dev-only-booking-code-hmac-secret
DEV_LOGIN_ENABLED=true
# HMAC key for one-time codes (optional in dev; required in production)
OTP_SECRET=dev-only-otp-secret-change-me
# Mixed into every password hash (review R11). Set ONCE per environment to a long random value and never change it:
# changing it locks every user out (they would have to reset their password).
PASSWORD_PEPPER=dev-only-password-pepper-change-me-in-production
# Security limits. Production refuses to start with dev secrets, dev login, SMS_PROVIDER=dev or limits off.
RATE_LIMIT_ENABLED=true
SMS_PROVIDER=dev
SESSION_MAX_DAYS=90

# Domains. *.lvh.me always resolves to 127.0.0.1, so clinic subdomains work locally:
#   http://lvh.me:3000            landing page
#   http://clinic-a.lvh.me:3000   demo clinic A website
ROOT_DOMAIN=lvh.me
# API -> website cache purge after a publish (set a long random value in production)
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=dev-only-revalidate-secret
API_PORT=4000
# Which proxies may set the client address (X-Forwarded-For). The public booking throttles are per visitor IP.
#   loopback              website and API on the same host (default)
#   loopback, 10.0.0.0/8  website in another container on a private network
#   1                     exactly one proxy hop in front of the API
TRUST_PROXY=loopback
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:5173
# the platform's landing page (review R11): linked from the "trial ending" email; set it in production
LANDING_URL=http://lvh.me:3000
# the landing page's "sample website" link (H7); in development it defaults to clinic-a, in production leave it unset
# until a real sample clinic exists
# DEMO_SITE_URL=http://clinic-a.lvh.me:3000

# Mail (Mailpit catches everything locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Dental SaaS <no-reply@lvh.me>"

# Image storage. Dev default: local disk (STORAGE_DIR, default <repo>/.storage). Production needs s3
# (Cloudflare R2, AWS S3 or any S3-compatible server); the S3_* values below are used only when STORAGE_DRIVER=s3.
STORAGE_DRIVER=local
# STORAGE_DIR=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=dental-dev
S3_FORCE_PATH_STYLE=true
# signs short-lived dashboard image links (set a long random value in production)
MEDIA_URL_SECRET=dev-only-media-url-secret
# the API's own public address, used in signed image links
API_PUBLIC_URL=http://localhost:4000

# Error tracking (Phase 1B): Sentry. Leave empty in development: nothing is sent. In production create one Sentry
# project for the servers (API + worker + websites, told apart by the "service" tag) and one for the dashboard.
# Request bodies, query strings, headers and users are never sent (docs/ops/monitoring.md).
SENTRY_DSN=
# defaults to NODE_ENV; set "staging" on a staging server
SENTRY_ENVIRONMENT=
# the deployed version (git sha or tag)
SENTRY_RELEASE=

# Dashboard (browser) — only VITE_* variables are exposed to the browser
VITE_API_URL=http://localhost:4000
VITE_ROOT_DOMAIN=lvh.me
# the dashboard's own Sentry project (read at build time); empty = off
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
